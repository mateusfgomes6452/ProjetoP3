<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.0"
    xmlns="http://java.sun.com/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
    	<class>entidades.Categoria</class>
    	<class>entidades.ContratoAluguel</class>
    	<class>entidades.Fornecedor</class>
    	<class>entidades.Item</class>
    	<class>entidades.Multa</class>
    	<class>entidades.Usuario</class>
    
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost/automoveis" />
            <property name="javax.persistence.jdbc.user" value="root" />
            <property name="javax.persistence.jdbc.password" value="password" />
            <property name="javax.persistence.jdbc.driver" value="com.mysql.jdbc.Driver" />

            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL5InnoDBDialect" />
            <property name="hibernate.hbm2ddl.auto" value="update" />
        </properties>
    </persistence-unit>
</persistence>